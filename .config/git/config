# git configuration

[user]
  name = Joe Lopes
  email = 2897144+lopes@users.noreply.github.com
  signingkey = ~/.ssh/github_signing_ed25519.pub

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential

[core]
  editor = hx
  pager = delta
  autocrlf = input
  hooksPath = ~/.config/git/hooks
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[interactive]
  diffFilter = delta --color-only

[delta]
  syntax-theme = base16
  navigate = true
  line-numbers = true
  side-by-side = false

[commit]
  gpgsign = true
  verbose = true

[branch]
  sort = -committerdate

[push]
  default = simple
  autoSetupRemote = true
  followTags = true

[pull]
  rebase = true

[fetch]
  prune = true
  pruneTags = true
  all = true
  auto = 0

[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true

[init]
  defaultBranch = main
  defaultRefFormat = files

[color]
  ui = auto
  diff = auto
  status = auto
  branch = auto
[color "branch"]
  current = yellow bold
  local = green bold
  remote = cyan bold
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
  whitespace = red reverse
[color "status"]
  added = green bold
  changed = yellow bold
  untracked = red bold

[tag]
  sort = version:refname
  gpgsign = true

[help]
  autocorrect = prompt

[column]
  ui = auto

[checkout]
  defaultRemote = origin

[rerere]
  enabled = 1
  autoupdate = 1

[rebase]
  autoSquash = true
  updateRefs = true

[alias]
  # status & diff (status -> st, diff -> df/dfs)
  st = status -sb
  df = diff
  dfs = diff --staged

  # log (log -> lg/lga)
  lg = log --oneline --graph --decorate
  lga = log --oneline --graph --decorate --all

  # branch & switch (switch -> sw/swc/main, branch -> br/del)
  sw = switch
  swc = switch --create
  main = switch main
  br = branch
  del = branch --delete

  # commit & stage (add -> a/aa, commit -> cm/amend)
  a = add
  aa = add --all
  cm = commit -m
  amend = commit --amend --no-edit

  # push & pull (push -> ps/psf, pull -> pl)
  ps = push
  psf = push --force-with-lease --force-if-includes
  pl = pull

  # undo & clean
  undo = reset HEAD~1 --mixed
  cleanall = clean --force --directory

  # config inspection
  aka = config --get-regexp ^alias
  conf = config --list --show-origin --show-scope

# machine-specific overrides go in ~/.config/git/config.local (untracked)
# placed last so local rules win under Git last-match-wins semantics
[include]
  path = ~/.config/git/config.local
