" vim configuration

" general
set nocompatible
syntax on
set encoding=utf-8
set number
set showmatch
set laststatus=2
set nojoinspaces
set belloff=all

" colorscheme (built-in default: respects terminal background & base16 ANSI palette)
set background=dark
colorscheme default

" improved wildmenu
set wildmode=longest:full,full
set wildignorecase
set wildignore=*.o,*~,*.pyc

" indentation
set autoindent
set expandtab
set tabstop=2
set shiftwidth=0
set softtabstop=-1 " aligns with shiftwidth

" new line in the end
set eol
set fixendofline

" search
set incsearch
set hlsearch
set ignorecase
set smartcase
set magic

" key mappings
inoremap <c-s> <esc>:w<cr>
nnoremap <c-s> :w<cr>
nnoremap <esc> :noh<return><esc>
nnoremap <leader>w :w<cr>
nnoremap <leader>q :q<cr>

" persistent undo (cache — regenerable)
set undofile
if !isdirectory($XDG_CACHE_HOME . '/vim/undodir')
  call mkdir($XDG_CACHE_HOME . '/vim/undodir', 'p', 0700)
endif
set undodir=$XDG_CACHE_HOME/vim/undodir
set undolevels=1000
set undoreload=10000

" file handling — viminfo is state (command/search history, marks), not cache
if !isdirectory($XDG_STATE_HOME . '/vim')
  call mkdir($XDG_STATE_HOME . '/vim', 'p', 0700)
endif
set viminfo='10,\"30,:40,%,n$XDG_STATE_HOME/vim/viminfo
let g:netrw_dirhistmax = 0
set nobackup
set noswapfile
set nowritebackup

augroup dotfiles
  autocmd!
  " restore last cursor position when valid (skip commit messages)
  autocmd BufReadPost * if line("'\"") > 0 && line("'\"") <= line("$") && &ft !~# 'commit' | execute "normal! g`\"" | endif
  " hledger journals: treat ':' as a keyword char so <C-n>/<C-p> complete whole
  " account paths (expenses:food:groceries) from open buffers — no need to retype
  " or remember the chart while categorizing an import
  autocmd BufRead,BufNewFile *.journal setlocal iskeyword+=:
augroup END

" visual improvements
set scrolloff=5
set sidescrolloff=5
set display+=lastline

" status line (solid mode pill matching tmux & helix on transparent bar)
set statusline=
set statusline+=%#NormalMode#%{(mode()=='n')?'\ NORMAL\ ':(mode()=='c')?'\ COMMAND\ ':''}%#InsertMode#%{(mode()=='i')?'\ INSERT\ ':''}%#VisualMode#%{(mode()=='v')?'\ VISUAL\ ':(mode()=='V')?'\ V-LINE\ ':(mode()==\"\<C-v>\")?'\ V-BLOCK\ ':''}%#ReplaceMode#%{(mode()=='R')?'\ REPLACE\ ':''}
set statusline+=%#StatusLine#\ %f\ %m
set statusline+=%=
set statusline+=%y\ %{&fenc}
set statusline+=\ %l:%c
set statusline+=\ %P\ 

highlight NormalMode   cterm=bold ctermfg=0 ctermbg=2
highlight InsertMode   cterm=bold ctermfg=0 ctermbg=5
highlight VisualMode   cterm=bold ctermfg=0 ctermbg=3
highlight ReplaceMode  cterm=bold ctermfg=0 ctermbg=1
highlight StatusLine   cterm=NONE ctermfg=7 ctermbg=NONE
highlight StatusLineNC cterm=NONE ctermfg=8 ctermbg=NONE

" simpler bottom
set noshowmode    " no -- INSERT -- ...
set noruler       " no line/col in bottom-right
set noshowcmd     " no partial commands
set cmdheight=1
set shortmess+=F  " no file info messages

