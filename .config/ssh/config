# ssh client configuration

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/github_ed25519
  IdentitiesOnly yes

Host *
  # known_hosts: hash hostnames, show fingerprint art on first connect
  HashKnownHosts yes
  VisualHostKey yes
  StrictHostKeyChecking accept-new

  # keep connections alive through nat/idle; drop after 3 missed probes
  ServerAliveInterval 60
  ServerAliveCountMax 3

  # only offer keys explicitly listed for each Host block (no key spray)
  IdentitiesOnly yes

# machine-specific overrides go in ~/.ssh/config.local (untracked)
Include config.local
